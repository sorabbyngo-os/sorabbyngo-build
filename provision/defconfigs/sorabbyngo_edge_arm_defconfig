# ============================================================
# Sorabbyngo Edge OS — ARM64 defconfig
# IoT, drones, vehicles — minimal footprint target <50MB
# ============================================================

BR2_aarch64=y
BR2_cortex_a55=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(TOPDIR)/../sorabbyngo-patches/sorabbyngo_edge.config"

# Minimal init
BR2_INIT_BUSYBOX=y

# Minimal packages only
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_ONLY=y

# CAN bus support
BR2_PACKAGE_CAN_UTILS=y

# Hardware interfaces
BR2_PACKAGE_LIBSERIALPORT=y

# Minimal networking
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_WPA_SUPPLICANT=y

BR2_ENABLE_LOCALE=n
BR2_TARGET_GENERIC_HOSTNAME="sorabbyngo-edge"
BR2_TARGET_GENERIC_ISSUE="Sorabbyngo Edge OS"

# Minimal filesystem — target <50MB
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_TARGET_ROOTFS_SQUASHFS=y

BR2_ROOTFS_OVERLAY="board/sorabbyngo/overlay board/edge/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/sorabbyngo/post-build.sh board/edge/post-build.sh"
